[Unit]
Description=Random movie/TV player -> HDMI (Saba TV via SCART adapter)
Documentation=file:/usr/local/bin/tvplayer
After=network-online.target
Wants=network-online.target
# /mnt/movies and /mnt/tv are systemd automounts (see /etc/fstab) -- accessing
# them triggers the NFS mount lazily, so no explicit mount unit dependency
# is needed here. Restart=always covers Unraid being briefly unreachable.
#
# NOT enabled at boot: tvgate.service starts/stops this unit to match the
# Saba TV's Shelly plug, so the array HDDs are not streaming to a dark tube.

[Service]
Type=simple
User=martin
SupplementaryGroups=video render input tty
RuntimeDirectory=tvplayer
RuntimeDirectoryMode=0770
# probe cache survives restarts in /var/lib/tvplayer
StateDirectory=tvplayer
# breathing room for the previous mpv to release DRM master: restarting
# without it once wedged the vc4 driver into an atomic-commit failure loop
# that pegged the CPU until a power cycle
# The framebuffer console re-attaches itself whenever mpv exits and hands
# DRM back -- which happens every time the television is switched off. So the
# set comes on showing a login prompt until the player catches up. noconsole
# only runs once at boot, so the unbind has to be repeated here, on both ends
# of every run. The + prefix runs these as root; the player itself does not.
ExecStartPre=+/bin/sh -c 'echo 0 > /sys/class/vtconsole/vtcon1/bind || true'
ExecStartPre=+/bin/sh -c 'dd if=/dev/zero of=/dev/fb0 bs=1M count=8 2>/dev/null || true'
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/python3 /usr/local/bin/tvplayer
# same reason, other edge: settle after stop before anything regrabs DRM
ExecStopPost=+/bin/sh -c 'echo 0 > /sys/class/vtconsole/vtcon1/bind || true'
ExecStopPost=+/bin/sh -c 'dd if=/dev/zero of=/dev/fb0 bs=1M count=8 2>/dev/null || true'
ExecStopPost=/bin/sleep 2
Restart=always
RestartSec=5
# mpv exits 4 when it is told to quit, which is exactly what happens every
# time tvgate stops the player because the television was switched off. Without
# this, systemd logs a normal shutdown as "Failed with result 'exit-code'" and
# the journal reads like a string of crashes when nothing has gone wrong.
SuccessExitStatus=4

[Install]
WantedBy=multi-user.target
